  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one committed action in an app view (New Task, Sign in).",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>New Task</button>",
      "css": ".ds-btn-primary{font-family:Inter,system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;gap:4px;padding:6px 12px;font-size:12px;font-weight:600;color:#fff;background:#4f46e5;border:none;border-radius:8px;cursor:pointer;transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:#4338ca}.ds-btn-primary:active{background:#3730a3}.ds-btn-primary:focus-visible{outline:2px solid #6366f1;outline-offset:2px}"
    },
    {
      "name": "Hero CTA pair on ink",
      "kind": "button",
      "refersTo": "button-primary-large",
      "description": "Landing primary and secondary actions on the slate-900 stage.",
      "html": "<div class=\"ds-ink\"><a class=\"ds-cta\" href=\"#\">Try the live demo <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a><a class=\"ds-cta-ghost\" href=\"#\">Watch the 20s tour</a></div>",
      "css": ".ds-ink{font-family:Inter,system-ui,-apple-system,sans-serif;background:#0f172a;padding:24px;display:flex;flex-wrap:wrap;gap:12px}.ds-cta,.ds-cta-ghost{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:12px;font-size:14px;font-weight:600;color:#fff;text-decoration:none;transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-cta{background:#4f46e5}.ds-cta:hover{background:#6366f1}.ds-cta-ghost{box-shadow:inset 0 0 0 1px rgba(255,255,255,.2)}.ds-cta-ghost:hover{background:rgba(255,255,255,.05)}.ds-cta:focus-visible,.ds-cta-ghost:focus-visible{outline:2px solid #6366f1;outline-offset:2px}"
    },
    {
      "name": "Copilot and Excel tinted buttons",
      "kind": "button",
      "refersTo": "button-copilot",
      "description": "Feature entry points: indigo for AI, emerald for the spreadsheet side.",
      "html": "<div class=\"ds-row\"><button class=\"ds-btn-ai\">AI Copilot</button><button class=\"ds-btn-xl\">Excel Hub</button></div>",
      "css": ".ds-row{font-family:Inter,system-ui,-apple-system,sans-serif;display:flex;gap:8px}.ds-btn-ai,.ds-btn-xl{padding:6px 12px;font-size:12px;font-weight:600;border-radius:8px;cursor:pointer;transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-btn-ai{color:#4338ca;background:#eef2ff;border:1px solid rgba(199,210,254,.8)}.ds-btn-ai:hover{background:#e0e7ff}.ds-btn-xl{color:#065f46;background:#ecfdf5;border:1px solid #a7f3d0}.ds-btn-xl:hover{background:#d1fae5}.ds-btn-ai:focus-visible,.ds-btn-xl:focus-visible{outline:2px solid #6366f1;outline-offset:2px}"
    },
    {
      "name": "Text input",
      "kind": "input",
      "refersTo": "input",
      "description": "Search, filter and form fields: cool-paper fill that turns white with an indigo border on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Search tasks…\" />",
      "css": ".ds-input{font-family:Inter,system-ui,-apple-system,sans-serif;width:260px;padding:6px 12px;font-size:12px;color:#0f172a;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;outline:none;transition:background-color .15s,border-color .15s}.ds-input::placeholder{color:#94a3b8}.ds-input:hover{border-color:#cbd5e1}.ds-input:focus-visible{background:#fff;border-color:#6366f1}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Slate-900 column; the active destination is the indigo fill.",
      "html": "<nav class=\"ds-side\"><div class=\"ds-side-h\">Workspaces</div><a class=\"ds-nav ds-nav-on\" href=\"#\"><span>Task List</span><span class=\"ds-count ds-count-on\">9</span></a><a class=\"ds-nav\" href=\"#\"><span>Kanban Board</span><span class=\"ds-count\">2</span></a><a class=\"ds-nav\" href=\"#\"><span>Calendar &amp; Deadlines</span></a></nav>",
      "css": ".ds-side{font-family:Inter,system-ui,-apple-system,sans-serif;width:240px;background:#0f172a;padding:16px 12px;display:flex;flex-direction:column;gap:4px}.ds-side-h{font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#94a3b8;padding:0 8px 8px}.ds-nav{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-radius:8px;font-size:12px;font-weight:500;color:#cbd5e1;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav:hover{background:rgba(30,41,59,.8);color:#fff}.ds-nav-on,.ds-nav-on:hover{background:#4f46e5;color:#fff}.ds-nav:focus-visible{outline:2px solid #6366f1;outline-offset:2px}.ds-count{font-variant-numeric:tabular-nums;font-size:10px;font-weight:700;padding:2px 6px;border-radius:9999px;background:#1e293b;color:#cbd5e1}.ds-count-on{background:rgba(55,48,163,.8);color:#fff}"
    },
    {
      "name": "Status and priority pills",
      "kind": "chip",
      "refersTo": "pill-status-in-progress",
      "description": "Fixed-meaning 50-wash + 700-text state pills.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-pill ds-blue\">In Progress</span><span class=\"ds-pill ds-violet\">In Review</span><span class=\"ds-pill ds-rose\">Blocked</span><span class=\"ds-pill ds-emerald\">Completed</span><span class=\"ds-pill ds-amber\">High</span><span class=\"ds-pill ds-slate\">Low</span></div>",
      "css": ".ds-pills{font-family:Inter,system-ui,-apple-system,sans-serif;display:flex;flex-wrap:wrap;gap:6px}.ds-pill{padding:2px 8px;border-radius:6px;font-size:11px;font-weight:600}.ds-blue{background:#eff6ff;color:#1d4ed8}.ds-violet{background:#f5f3ff;color:#6d28d9}.ds-rose{background:#fff1f2;color:#be123c}.ds-emerald{background:#ecfdf5;color:#047857}.ds-amber{background:#fffbeb;color:#b45309}.ds-slate{background:#f1f5f9;color:#475569}"
    },
    {
      "name": "Task table panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Hairline-bordered white panel with uppercase column labels and dense rows.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-th\"><span>Task heading</span><span>Priority</span><span>Due</span></div><div class=\"ds-tr\"><span class=\"ds-t\">Prepare Q4 budget report</span><span class=\"ds-p ds-u\">Urgent</span><span class=\"ds-d\">Oct 21</span></div><div class=\"ds-tr\"><span class=\"ds-t\">Weekly sprint retro notes</span><span class=\"ds-p ds-m\">Medium</span><span class=\"ds-d\">Oct 19</span></div></div>",
      "css": ".ds-panel{font-family:Inter,system-ui,-apple-system,sans-serif;width:420px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden}.ds-th,.ds-tr{display:grid;grid-template-columns:1fr 80px 56px;align-items:center;padding:10px 16px}.ds-th{background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#64748b}.ds-tr{border-bottom:1px solid #f1f5f9;font-size:12px;transition:background-color .15s}.ds-tr:hover{background:rgba(248,250,252,.8)}.ds-t{font-weight:600;color:#1e293b}.ds-p{justify-self:start;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600}.ds-u{background:#fff1f2;color:#be123c}.ds-m{background:#eff6ff;color:#1d4ed8}.ds-d{font-variant-numeric:tabular-nums;color:#64748b}"
    },
    {
      "name": "Viewer switch with scope probe",
      "kind": "custom",
      "refersTo": "viewer-switch",
      "description": "Signature segmented radio that flips scope; the footer prints the count and the API response.",
      "html": "<div class=\"ds-vs\"><div class=\"ds-vs-bar\"><span class=\"ds-vs-l\">Viewing as</span><div class=\"ds-vs-track\" role=\"radiogroup\"><button class=\"ds-vs-o\" role=\"radio\" aria-checked=\"false\">Alexander <span>· Admin</span></button><button class=\"ds-vs-o ds-vs-on\" role=\"radio\" aria-checked=\"true\">Sarah <span>· User</span></button></div></div><div class=\"ds-vs-f\"><span><b>4</b> of 9 tasks visible · own tasks only</span><code>GET /api/tasks/5647ef57… → 404 Not Found</code></div></div>",
