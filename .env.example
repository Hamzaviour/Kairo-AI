# ============================================================
# Kairo — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit the real .env file to version control.

# ---- Database ------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:<password>@ep-holy-paper-b5f3cirg-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---- Authentication ------------------------------------------
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider (optional) ----------------------------------
# Supported: openai, google, anthropic, azure_openai
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=   # Optional: custom endpoint for Azure or proxies

# ---- Chat assistants (Groq) ----------------------------------
# Powers the floating user and admin assistants (bottom-right of the workspace)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ---- CORS ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Email (optional) ----------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ---- Application ---------------------------------------------
APP_NAME=Kairo
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
